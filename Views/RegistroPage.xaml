<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RegistroEstudiantesMVVM.ViewModels"
             xmlns:models="clr-namespace:RegistroEstudiantesMVVM.Models"
             x:Class="RegistroEstudiantesMVVM.Views.RegistroPage"
             x:DataType="vm:RegistroViewModel"
             Title="Registro de Estudiantes">

    <Grid RowDefinitions="Auto, *" Padding="15" RowSpacing="10">

        <!-- Formulario -->
        <VerticalStackLayout Spacing="8">
            <Label Text="Nombre" FontAttributes="Bold" />
            <Entry Text="{Binding Nombre}" Placeholder="Ingrese nombre" />

            <Label Text="Correo" FontAttributes="Bold" />
            <Entry Text="{Binding Correo}" Placeholder="Ingrese correo" Keyboard="Email" />

            <Label Text="Teléfono" FontAttributes="Bold" />
            <Entry Text="{Binding Telefono}" Placeholder="Ingrese teléfono" Keyboard="Telephone" />

            <Label Text="Carrera" FontAttributes="Bold" />
            <Entry Text="{Binding Carrera}" Placeholder="Ingrese carrera" />

            <Label Text="Fecha" FontAttributes="Bold" />
            <DatePicker Date="{Binding Fecha}" />

            <Button Text="Guardar" Command="{Binding GuardarCommand}"
                    BackgroundColor="#512BD4" TextColor="White" FontSize="16" />
        </VerticalStackLayout>

        <!-- Lista de estudiantes -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Estudiantes}">
            <CollectionView.EmptyView>
                <Label Text="No hay estudiantes registrados." HorizontalOptions="Center"
                       TextColor="Gray" Margin="0,20,0,0" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Estudiante">
                    <Border Margin="0,5" Padding="10" StrokeShape="RoundRectangle 8" Stroke="#E0E0E0">
                        <VerticalStackLayout>
                            <Label Text="{Binding Nombre}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding Carrera}" FontSize="14" TextColor="Gray" />
                            <Label Text="{Binding Correo}" FontSize="13" TextColor="#512BD4" />
                            <Label Text="{Binding Telefono}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
